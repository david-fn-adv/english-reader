  "outlet": "Skift",
  "author": "Peden Doma Bhutia",
  "title": "India Is Now Skyscanner's Biggest Market, and Nearly Half Its Searches Go Abroad",
  "date": "2026-10-12",
  "accessed": "2026-10-15",
  "second_source": "https://theprint.in/ani-press-releases/skyscanner-unveils-travel-trends-2027-travel-better-spent/3071449/",
  "notes": "Skift body is paywalled after the redirect figures; 28 days, 3.1 days and the destinations come from Skift's own Key Points / Summary on the same page. Survey figures come from Skyscanner's Travel Trends 2027 press release (ANI/ThePrint, 2026-10-14), a company-commissioned survey; 67% and 87% match Skift's summary. Destination growth percentages left out: their basis is not stated.",
  "figures": [
   {
    "id": "f1",
    "text": "India is now Skyscanner's biggest market",
    "quote": "India Is Now Skyscanner's Biggest Market"
   },
   {
    "id": "f2",
    "text": "searches from India up 22% vs 17% global",
    "quote": "with searches from the country rising 22% year over year, outpacing the global growth rate of 17%"
   },
   {
    "id": "f3",
    "text": "three years ago 80% domestic, 20% international",
    "quote": "roughly 80% of Skyscanner's India redirects went toward domestic bookings and just 20% toward international travel"
   },
   {
    "id": "f4",
    "text": "today 52% domestic, 48% international",
    "quote": "Today, the split is almost even, with 52% domestic and 48% international."
   },
   {
    "id": "f5",
    "text": "Neel Ghose spoke to journalists in Delhi about Travel Trends 2027",
    "quote": "Ghose told journalists in Delhi while discussing Skyscanner's Travel Trends 2027 report"
   },
   {
    "id": "f6",
    "text": "survey of 2,000 Indian travelers, July 2026",
    "quote": "insights into 2,000 Indian travelles ... It took place in July 2026"
   },
   {
    "id": "f7",
    "text": "58% plan to travel abroad more in 2027",
    "quote": "with 58% of Indians planning to travel abroad more in 2027"
   },
   {
    "id": "f8",
    "text": "56% spend more on flights, 44% on places to stay",
    "quote": "with 56% planning to spend more on flights and 44% on accommodation"
   },
   {
    "id": "f9",
    "text": "28-day booking window, about half of several other major markets",
    "quote": "an average 28-day booking window, about half that of several other major markets"
   },
   {
    "id": "f10",
    "text": "average trip 3.1 days",
    "quote": "average trip length down to 3.1 days"
   },
   {
    "id": "f11",
    "text": "67% changed or considered changing destination for better value",
    "quote": "67% having changed a holiday destination or considered doing so because an alternative offered better value"
   },
   {
    "id": "f12",
    "text": "87% confident using AI to plan and book",
    "quote": "With 87% of Indians now confident using AI to plan and book travel"
   },
   {
    "id": "f13",
    "text": "more than half plan to use AI for destination research; accuracy a key consideration for more than half",
    "quote": "more than half planning to turn to AI for destination research ... accuracy remains a key consideration for more than half of travellers"
   },
   {
    "id": "f14",
    "text": "no evidence yet that travelers let AI complete bookings",
    "quote": "Skyscanner says accuracy concerns remain and it lacks evidence that travelers routinely let AI complete bookings"
   },
   {
    "id": "f15",
    "text": "interest in Bishkek, Baku, Tashkent, Japan, Vietnam",
    "quote": "helping drive interest in Bishkek, Baku, and Tashkent alongside Japan and Vietnam"
   }
  ]
