{
 "id": "2026-11-16",
 "domain": "business",
 "title": "Food Prices Rise Again as Fuel Costs More",
 "level": {
  "known_version": "2026-10-15",
  "frontier_band": 4
 },
 "source": {
  "url": "https://www.retaildive.com/news/grocery-inflation-october-2026-meat-produce-coffee/874599/",
  "outlet": "Retail Dive (from Grocery Dive)",
  "author": "Sam Silverstein",
  "title": "Consumers face higher grocery prices",
  "date": "2026-11-12",
  "accessed": "2026-11-16",
  "checked_against": "Single source: a news report of the October Consumer Price Index data. Figures come only from this article; the government tables were not opened. Bananas, potatoes, tomatoes, ham, poultry and the fuel price per gallon are left out. 'Lettuce' is written as 'salad leaves' and 'diesel' as 'one kind of fuel' to stay inside the reader's vocabulary.",
  "figures": [
   {
    "id": "f1",
    "text": "food-at-home prices up 0.4% in October from the previous month, largest monthly rise since April",
    "quote": "Food-at-home prices increased 0.4% in October compared with the previous month, the largest month-to-month increase in grocery inflation since April"
   },
   {
    "id": "f2",
    "text": "data published by the U.S. Bureau of Labor Statistics",
    "quote": "according to Consumer Price Index data published Tuesday by the U.S. Bureau of Labor Statistics"
   },
   {
    "id": "f3",
    "text": "no annual figure for October: no data collected in October 2025 because the government was shut",
    "quote": "it did not collect data during that month in 2025 due to last year’s federal government shutdown"
   },
   {
    "id": "f4",
    "text": "fresh vegetables up more than 2%",
    "quote": "Prices for fresh vegetables surged more than 2% last month"
   },
   {
    "id": "f5",
    "text": "lettuce up almost 8%",
    "quote": "lettuce prices leapt almost 8%"
   },
   {
    "id": "f6",
    "text": "fresh fruit down; apples down 1.6%",
    "quote": "Fresh fruit prices, on the other hand, were down, as apple prices shed 1.6%"
   },
   {
    "id": "f7",
    "text": "meat trending upward; ground beef up about 1%, beef steak up almost 2%",
    "quote": "uncooked ground beef rose by approximately 1%, and uncooked beef steak prices moved ahead by almost 2%"
   },
   {
    "id": "f8",
    "text": "coffee down about 3.5%",
    "quote": "Coffee prices declined, cooling by about 3.5%."
   },
   {
    "id": "f9",
    "text": "diesel up 60% from a year ago, as of Monday (early November)",
    "quote": "The average price for a gallon of the fuel was $6.13 as of Monday, up 60% from a year ago"
   },
   {
    "id": "f10",
    "text": "grocery inflation has bounced around in 2026: up in January and February, nearly 1% in April with the Iran war",
    "quote": "moved up month to month in January and February before racing ahead nearly 1% in April as the Iran war disrupted crude oil supplies"
   },
   {
    "id": "f11",
    "text": "slower in May and June, slight falls in July and September",
    "quote": "Grocery inflation slowed in May and June before declining slightly in July and again in September."
   },
   {
    "id": "f12",
    "text": "FMI: grocers working to keep prices in check and supplies dependable",
    "quote": "grocers have been working to keep prices in check and maintain dependable supplies even as fuel costs have increased"
   },
   {
    "id": "f13",
    "text": "FMI said in September that prices would rise faster later in 2026 as costs are passed on",
    "quote": "predicted in September that grocery prices would accelerate later in 2026 as retailers and suppliers began to pass on the rising costs"
   },
   {
    "id": "f14",
    "text": "Andy Harig of FMI: fuel costs show in the cost to produce and deliver food; it can take months",
    "quote": "reflected in what it takes to produce and deliver food, and it can take months for them to show up in grocery prices, which we are now witnessing"
   }
  ]
 },
