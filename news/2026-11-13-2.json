 "source": {
  "url": "https://www.retaildive.com/news/calvin-klein-tommy-hilfiger-owner-to-cut-4-of-workforce/874492/",
  "outlet": "Retail Dive",
  "author": "Dani James",
  "title": "Calvin Klein, Tommy Hilfiger owner to cut 4% of workforce",
  "date": "2026-11-12",
  "accessed": "2026-11-13",
  "checked_against": "Single source. Web search on 2026-11-13 found no second report of the November 2026 cuts yet (results only showed PVH's earlier 2020-2023 job-cut programs), so no figure was cross-checked and none was taken from another source. Extra article requested by Dương on 2026-11-13 to make up for the skipped business day 2026-11-09.",
  "figures": [
   {
    "id": "f1",
    "text": "Retail Dive article published November 12, 2026",
    "quote": "Published Nov. 12, 2026"
   },
   {
    "id": "f2",
    "text": "PVH to reduce global workforce by about 4%, focus on non-consumer-facing positions",
    "quote": "plans to reduce its global workforce by about 4% with a focus on non-consumer-facing positions"
   },
   {
    "id": "f3",
    "text": "plan disclosed in a Thursday filing with the U.S. Securities and Exchange Commission",
    "quote": "according to a Thursday U.S. Securities and Exchange Commission filing"
   },
   {
    "id": "f4",
    "text": "cuts equal about 12% of office-based associates",
    "quote": "It represents cuts to about 12% of its office-based associates."
   },
   {
    "id": "f5",
    "text": "actions began immediately, to finish within the first quarter of 2027",
    "quote": "The actions began immediately and are expected to wrap up within the first quarter of 2027."
   },
   {
    "id": "f6",
    "text": "100 million dollars of pre-tax cost savings in fiscal year 2027, from people and non-people savings",
    "quote": "expects to achieve $100 million of pre-tax cost savings in fiscal year 2027 via \"people and non-people savings,\""
   },
   {
    "id": "f7",
    "text": "aims: improve productivity, strengthen long-term growth",
    "quote": "PVH is aiming to improve productivity, strengthen long-term growth and further the execution of its broader strategic priorities."
   },
   {
    "id": "f8",
    "text": "simplify ways of working: less duplicative work, fewer organizational layers",
    "quote": "The company wants to simplify ways of working by minimizing duplicative work and reducing organizational layers"
   },
   {
    "id": "f9",
    "text": "PVH also wants to invest in product innovation, supply chain, e-commerce",
    "quote": "PVH also wants to invest in product innovation, its supply chain, e-commerce and more."
   },
   {
    "id": "f10",
    "text": "second quarter revenue down 3% year over year to about 2 billion dollars",
    "quote": "PVH's second quarter revenue dropped 3% year over year to about $2 billion, per a September release."
   },
   {
    "id": "f11",
    "text": "Tommy Hilfiger revenue about flat, Calvin Klein down 7%",
    "quote": "Tommy Hilfiger revenue was about flat and Calvin Klein dropped 7%."
   },
   {
    "id": "f12",
    "text": "revenue down in Europe, the Middle East, Africa and the Americas; some gains in Asia Pacific",
    "quote": "Revenue decreased in the Europe, the Middle East, Africa and Americas regions, whereas APAC saw some gains."
   },
   {
    "id": "f13",
    "text": "full-year guidance: flat revenue compared to the year prior",
    "quote": "The company reiterated its full-year guidance of flat revenue compared to the year prior."
   },
   {
    "id": "f14",
    "text": "Jefferies analysts, October note: e-commerce the strongest evidence brand investments are working",
    "quote": "\"E-com is the strongest evidence that brand investments are working,\" the analysts said in an emailed note in October."
   },
   {
    "id": "f15",
    "text": "Jefferies analysts: Europe under outsized pressure, outlook for next year uncertain",
    "quote": "\"However, Europe has seen outsized pressure, and the outlook for next [year] remains uncertain.\""
   }
  ]
