  "title": "Ross Stores completes 2026 expansion plan with 115 new locations",
  "date": "2026-10-13",
  "accessed": "2026-10-15",
  "checked_against": "https://www.tradeandindustrydev.com/industry/retail/news/ross-stores-opens-51-new-locations-across-17-36482",
  "figures": [
   {
    "id": "f1",
    "text": "51 stores in September and October",
    "quote": "opened 51 stores across its Ross Dress for Less and dd's Discounts banners in September and October"
   },
   {
    "id": "f2",
    "text": "41 Ross Dress for Less, 10 dd's Discounts, 17 states",
    "quote": "added 41 Ross Dress for Less stores and 10 dd's Discounts locations across 17 states"
   },
   {
    "id": "f3",
    "text": "115 openings in fiscal 2026",
    "quote": "completing its store expansion plans for fiscal 2026 ... bringing its total store openings for the year to 115"
   },
   {
    "id": "f4",
    "text": "first stores in Massachusetts; more in New York",
    "quote": "The latest openings include Ross Dress for Less' first stores in Massachusetts ... further expansion in New York and other existing markets"
   },
   {
    "id": "f5",
    "text": "dd's Discounts core markets California, Florida, Texas",
    "quote": "dd's Discounts continued to expand in its core markets of California, Florida and Texas"
   },
   {
    "id": "f6",
    "text": "Richard Lietz, executive vice president, property development",
    "quote": "Each new opening allows us to deliver compelling value to even more customers ... while creating new jobs and making a positive impact in local communities"
   },
   {
    "id": "f7",
    "text": "Boys & Girls Clubs and First Book",
    "quote": "also made donations to local Boys & Girls Clubs and First Book literacy partners"
   },
   {
    "id": "f8",
    "text": "about 2,377 stores in 45 states, DC, Guam, Puerto Rico",
    "quote": "currently operate approximately 2,377 stores combined across 45 US states, the District of Columbia, Guam and Puerto Rico"
   },
   {
    "id": "f9",
    "text": "at least 2,900 Ross Dress for Less, 700 dd's Discounts, no date",
    "quote": "aims to eventually expand its Ross Dress for Less network to at least 2,900 locations ... its dd's Discounts footprint to 700 stores"
   },
   {
    "id": "f10",
    "text": "off-price retailer; branded goods at discounted prices",
    "quote": "consumers continue to seek branded merchandise at discounted prices"
   }
  ]
